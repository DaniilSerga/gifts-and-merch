{
  "name": "gifts-and-merch",
  "private": true,
  "version": "1.0.0",
  "description": "Fullstack: NestJS backend, React frontend, React admin",
  "workspaces": [
    "admin",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:all": "concurrently -n frontend,admin,backend -c blue,green,magenta \"npm run dev:frontend\" \"npm run dev:admin\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:admin && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:admin": "npm run lint --workspace=admin",
    "lint:backend": "npm run lint --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
